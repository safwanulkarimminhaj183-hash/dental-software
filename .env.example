# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000

# ─── Client ───────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000
CLIENT_URL=http://localhost:5173

# ─── MongoDB ──────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/dentist_db

# ─── JWT Authentication ───────────────────────────────────────────────────────
JWT_SECRET=dentocare_jwt_secret_key_2026_change_in_production

# ─── RBAC Admin Sandbox Bypass (Development Only) ────────────────────────────
ADMIN_SANDBOX_KEY=dentocare_admin_sandbox_key_2026

# ─── Redis Caching (Optional — falls back to MongoDB if unavailable) ─────────
REDIS_URL=redis://127.0.0.1:6379

# ─── Email / SMTP (Nodemailer) ────────────────────────────────────────────────
EMAIL_SERVICE=gmail
EMAIL_USER=dentist.official@gmail.com
EMAIL_PASS=your_gmail_app_password_here
DENTIST_EMAIL=dentist.official@gmail.com

# SMTP config (alternative to EMAIL_USER shorthand above)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dentist.official@gmail.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM="DentoCare Clinic <notifications@dentocare.clinic>"

# ─── Doctor Info (for PDF prescriptions) ─────────────────────────────────────
DOCTOR_LICENSE=DC-LICENSE-98412

# ─── Stripe Payment Gateway ───────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_signing_secret_here

# ─── SSLCommerz Payment Gateway (Bangladesh) ─────────────────────────────────
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASS=your_sslcommerz_store_password
SSLCOMMERZ_IS_LIVE=false
