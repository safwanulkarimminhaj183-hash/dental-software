# ─────────────────────────────────────────────────────────────
# DentoCare Backend — Environment Variables Reference (.env.example)
# Copy this file to .env and fill in your actual values.
# ─────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ── Database (MongoDB) ────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/dentist_db

# ── JWT Authentication ────────────────────────────────────────
JWT_SECRET=your_strong_random_jwt_secret_at_least_32_chars

# ── Nodemailer / Gmail SMTP ───────────────────────────────────
# HOW TO GET Gmail App Password:
#  1. Go to myaccount.google.com → Security
#  2. Enable 2-Step Verification
#  3. Search "App passwords" → Select "Mail" → Generate
#  4. Copy the 16-character password (no spaces) → paste below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
EMAIL_USER=yourclinicemail@gmail.com
EMAIL_PASS=xxxx_xxxx_xxxx_xxxx

# ── Clinic & Admin Info ───────────────────────────────────────
ADMIN_EMAIL=admin@yourclinicdomain.com
CLINIC_NAME=DentoCare Dental Clinic
CLINIC_PHONE=+1 (512) 205-1826
CLINIC_ADDRESS=Jalalabad, Sylhet, Bangladesh 3100
